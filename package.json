{
  "name": "danger-guard-plugin",
  "version": "1.0.0",
  "description": "Deterministic pre-exec interception of destructive shell commands for OpenClaw agents: pattern matching, approval gates, and Feishu alerts.",
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "security",
    "danger-guard",
    "shell-safety",
    "agent-safety"
  ],
  "license": "MIT",
  "dependencies": {
    "typebox": "1.3.18"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.2"
  },
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "compat": {
      "pluginApi": ">=2026.9.2",
      "minGatewayVersion": "2026.9.2"
    }
  }
}
